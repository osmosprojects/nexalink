# ====================================================================
# NexaLink CRM — Production Environment Configuration (.env)
# ====================================================================

# Application Server
PORT=5000
NODE_ENV=production
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=nexalink_crm

# Authentication & Security
# Generate a secure 32+ character random string
JWT_SECRET=your_super_secret_jwt_random_key_min_32_characters
JWT_EXPIRES_IN=7d

# AI Intelligence Service
# Options: 'built_in' (embedded smart heuristics) or 'openai' / 'gemini'
AI_PROVIDER=built_in
AI_API_KEY=
